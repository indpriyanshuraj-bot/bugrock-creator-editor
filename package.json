{
  "name": "bugrock-creator-editor",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Mobile-first Minecraft Bedrock add-on toolkit (experimental)",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm -r run build",
    "check:boundary": "node scripts/check-core-boundary.mjs",
    "check:dco": "node scripts/check-dco.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.0",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
